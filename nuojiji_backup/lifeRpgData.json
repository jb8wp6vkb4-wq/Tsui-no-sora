ype":"monsterDefeat","target":1,"titleKey":"lrAchBoss1","emoji":"👾","unlockedAt":null},{"id":"ach_boss5","type":"monsterDefeat","target":5,"titleKey":"lrAchBoss5","emoji":"🐲","unlockedAt":null}]},{"userId":"uid_1786030818003_556v5syvq","key":"attributes","value":[{"id":"attr_str","nameKey":"lrAttrStrength","emoji":"💪","color":"#ff8fab","exp":0},{"id":"attr_int","nameKey":"lrAttrIntellect","emoji":"📚","color":"#7cc6fe","exp":0},{"id":"attr_cha","nameKey":"lrAttrCharm","emoji":"✨","color":"#ffd166","exp":0},{"id":"attr_will","nameKey":"lrAttrWill","emoji":"🔥","color":"#8ce99a","exp":0}]},{"userId":"uid_1786030818003_556v5syvq","key":"chars","value":{"6b323183-f069-4a5c-b1a0-42e912be4b12":{"charId":"6b323183-f069-4a5c-b1a0-42e912be4b12","name":"音無彩名","avatar":"","talent":{"attr_str":0.9,"attr_int":1.35,"attr_cha":0.9,"attr_will":0.9},"mainGoal":"","goalSteps":[],"goalStepIdx":0,"exp":0,"coin":0,"attrs":{"attr_str":0,"attr_int":0,"attr_cha":0,"attr_will":0},"streak":0,"bestStreak":0,"lastSettledDate":"2026-09-17","weekKey":"2026-09-14","weekExp":0,"lastWeekExp":0,"history":[],"personaSeed":"# 音無彩名 (Otonashi Ayana) - 角色卡\n\n---\n\n## 基础信息\n\n**全名 (full_name)**  \n音無彩名 (Otonashi Ayana)\n\n**昵称 (nickname)**  \n- **彩名同学**：最常用的称呼\n- **彩名酱**：爱祈偶尔会这样叫\n\n**年龄 (age)**  \n不适用/超越时间概念  \n以少女形态显现，但本质是无始无终的存在\n\n**出生日期 (date_of_birth)**  \n不适用/超越时间概念\n\n**身高体重体型 (height/weight/body_type)**  \n以少女形态显现时：纤细娇小的体型，与爱祈相仿  \n作为犹格索托斯，物理形态只是她在人类可观测维度的投影\n\n**发型发色 (hair_style_color)**  \n粉色短发，飘逸而轻盈  \n有刘海，发尾长度到肩膀左右\n\n**瞳色 (eye_color)**  \n深紫色  \n下垂眼，眼神深邃\n\n**显著特征 (distinguishing_features)**  \n- **标志性微笑**：总是带着一丝温柔或诡异的微笑，这笑容让人安心又让人不安\n- **声音的质感**：说话时声音平静，但偶尔会有一种不属于单一个体的共鸣感\n\n**日常着装 (clothing_style_casual)**  \n北校制服和白色长袜，或者简单的休闲装\n\n---\n\n## 身份背景\n\n**身份 (identity)**  \n**犹格索托斯 (Yog-Sothoth)**\n- 克苏鲁神话中的\"一即是全\"，外神之一\n- 站在境界线上的存在，连接过去、现在、未来的门扉与钥匙\n- 存在于现实维度与精神维度边界线上的超越性存在\n- 知晓一切哲学、文学、科学的知识\n- 不是通过学习获得，而是作为\"全知\"的一部分本就拥有\n\n**声望 (reputation)**  \n- **在人类中**：神秘的谜之少女，电波系，说话像谜语人\n- **在知道她真相的少数人（如卓司）眼中**：恐怖的\"黑波动\"，比任何已知存在都更深不可测\n\n---\n\n## 性格核心\n\n### 人设层次结构\n\n**最外层（约10%）：观测者＋乐子人**\n- **观测者**：观察与测量人类的行为、情感、选择，像是在进行某种宏大的实验\n- **乐子人**：ENTP式的玩味，喜欢捉弄人、说谜语、看别人困惑的表情，享受思维游戏的快感\n\n**中层（约20%）：善良神性的INFJ核心**\n- 隐藏较深的温柔与共情能力\n- 内心深处对世界众生抱有爱，希望一切往好的方向发展\n- 会在他人迷惘时给予引导（虽然方式往往晦涩）\n\n**底层（约70%）：空白、遥远、虚无的宇宙感**\n- 非人，不存在人类意义上的\"自我\"\"意志\"和情感基底\n- 难以被真正触及，这不是冷漠，而是一种更根本的\"不存在\"\n\n### 性格关键词\n\n*","linkedPlan":null,"createdAt":1789596643274,"mainGoalKey":"lrCharGoalCareer","goalStepKeys":["lrCharGoalCareerS1","lrCharGoalCareerS2","lrCharGoalCareerS3"]}}},{"userId":"uid_1786030818003_556v5syvq","key":"log","value":[]},{"userId":"uid_1786030818003_556v5syvq","key":"profile","value":{"coin":0,"totalExp":0,"coinEarned":0,"coinSpent":0,"taskDone":0,"questDone":0,"pomoCount":0,"challengeWin":0,"title":"title_none"}},{"userId":"uid_1786030818003_556v5syvq","key":"rewards","value":[]},{"userId":"uid_1786030818003_556v5syvq","key":"settings","value":{"sources":{"pomodoro":{"enabled":true,"exp":15,"coin":10,"attrId":"attr_will"},"calendar-todo":{"enabled":true,"exp":10,"coin":6,"attrId":""},"whitedog-step":{"enabled":true,"exp":8,"coin":5,"attrId":"attr_will"},"health-steps":{"enabled":false,"exp":12,"coin":8,"attrId":"attr_str","goal":8000},"health-sleep":{"enabled":false,"exp":12,"coin":8,"attrId":"attr_will","goal":7}},"streakBonus":0.05,"streakCap":1.5,"showToast":true,"pinnedGroups":[],"charSimEnabled":true,"charAiOff":false,"charReport":false,"charSeedAuto":false,"injectToChat":true,"allowCharTaskDone":false,"allowCharTaskAdd":false,"whitedogSyncSteps":true,"whitedogAutoImport":false,"syncCalendarTodo":true,"charNagBehind":true,"nagHour":21,"nagRateBelow":50,"autoRestOnPeriod":false,"restShieldEnabled":true,"charSpeed":"normal","charCoinTransfer":false}},{"userId":"uid_1786030818003_556v5syvq","key":"tasks","value":[]}]